{
  "name": "damonshome-server",
  "version": "1.0.0",
  "description": "File management server",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "ANTUJIA_DIR=./data nodemon app.js",
    "dev:win": "set ANTUJIA_DIR=.\\data&& nodemon app.js",
    "build": "node postbuildService.js",
    "commit": "npm run build && git add . && git commit -m \"feat: server开发\" && git push origin main"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1",
    "ssh2": "^1.17.0"
  }
}
